# Test-only values for the end-to-end run. They work only against the throwaway database below,
# which is wiped at the start of every run; they are not used anywhere else.
BACKEND_DIR=../backend
BACKEND_PORT=4100
CMS_PORT=3101
# Serves the seeded test images and PDF in place of S3.
FIXTURE_PORT=4200
MONGODB_URI=mongodb://localhost:27017/portfolio-e2e
JWT_SECRET=e2e-only-secret-that-is-at-least-32-characters
ADMIN_EMAIL=e2e-admin@example.test
ADMIN_PASSWORD=e2e-only-password-0001

# Backend API, called only from the CMS server (never from the browser).
BACKEND_URL=http://localhost:4000

# Public portfolio, for the "View portfolio" link.
PORTFOLIO_URL=http://localhost:3000

# Optional: the public address of uploaded files when they are served from a CDN instead of S3
# (the same value as the backend's MEDIA_PUBLIC_BASE_URL). Read at build time.
MEDIA_PUBLIC_BASE_URL=
